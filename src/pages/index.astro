---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import SideNav from '../components/SideNav.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Capabilities from '../components/Capabilities.astro';
import Clients from '../components/Clients.astro';
import Talks from '../components/Talks.astro';
import Background from '../components/Background.astro';
import Signature from '../components/Signature.astro';
import Footer from '../components/Footer.astro';
import VideoModal from '../components/VideoModal.astro';
---

<Base>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <SideNav />
  <MobileMenu />

  <main id="main">
    <Hero />
    <Projects />
    <Capabilities />
    <Clients />
    <Talks />
    <Background />
  </main>

  {/* Firma y pie se revelan juntos por detrás del contenido al llegar al
      final del scroll, como en paper.design: van fijos bajo `main`, que los
      tapa con fondo opaco hasta la última franja de la página (ver estilo
      abajo y `initFooterReveal` en motion.js, que mide su altura real). */}
  <div class="reveal">
    <Signature />
    <Footer />
  </div>

  <VideoModal />

  <script>
    import '../scripts/video-modal.js';
    import '../scripts/mobile-menu.js';
    import '../scripts/motion.js';
  </script>
</Base>

<style>
  main {
    position: relative;
    z-index: 1;
    background: var(--paper);
    /* El trazo que antes llevaba `.signature` por arriba: al vivir aquí viaja
       con el contenido que sube y hace más notorio que hay algo detrás. */
    box-shadow: inset 0 -1px 0 var(--ink-pure);
  }

  /* El truco es puro layout ligado al scroll, pero el efecto en sí —contenido
     que tapa y descubre algo "detrás"— es el mismo tipo de ilusión de
     profundidad que el parallax, y puede marear igual. Con movimiento
     reducido el pie vuelve al flujo normal, sin fijarlo ni reservarle hueco. */
  @media (prefers-reduced-motion: no-preference) {
    main {
      margin-bottom: var(--reveal-h, 0px);
    }

    .reveal {
      position: fixed;
      inset-block-end: 0;
      inset-inline: 0;
      z-index: 0;
    }
  }
</style>
