---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

{/* No está en el diseño: la mínima expresión con los mismos tokens que la home. */}
<Base title={`Page not found — ${site.name}`} noindex>
  <main class="not-found">
    <h1 class="not-found__title">Nothing here.</h1>
    <p class="not-found__text">This page doesn’t exist, or doesn’t anymore.</p>
    <a class="not-found__link" href="/">Back to {site.name} →</a>
  </main>
</Base>

<style>
  .not-found {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(16px * var(--k));
    padding-inline: var(--grid-margin);
  }

  .not-found__title {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--fw-regular);
    line-height: var(--lh-display);
    color: var(--ink-pure);
  }

  .not-found__text {
    font-size: var(--fs-md);
  }

  .not-found__link {
    font-size: var(--fs-md);
    font-weight: var(--fw-medium);
    color: var(--accent);
  }

  @media (max-width: 719.98px) {
    .not-found__title {
      font-size: var(--fs-display-sm);
    }
  }
</style>
