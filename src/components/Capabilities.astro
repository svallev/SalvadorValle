---
import { getCollection } from 'astro:content';
import { sections } from '../data/site';

const capabilities = (await getCollection('capabilities')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section class="caps grid">
  <h2 class="caps__label">{sections.capabilities.label}</h2>

  <ul class="caps__list" role="list">
    {
      capabilities.map((item) => (
        <li class="caps__item" data-reveal>
          <h3 class="caps__title">{item.data.title}</h3>
          <p class="caps__summary">{item.body}</p>
        </li>
      ))
    }
  </ul>

  <p class="caps__quote">{sections.capabilities.quote}</p>
</section>

<style>
  /* Frame 17: arranca justo tras el collage y deja 80 px debajo. */
  .caps {
    padding-block: 0 80px;
  }

  .caps__label {
    grid-column: 4 / -1;
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    color: var(--accent);
    line-height: var(--lh-tight);
  }

  /* Filas iguales, las fija la capacidad más larga (en los dos artboards de
     escritorio). 20 px antes de la lista y 40 px antes de la cita. */
  .caps__list {
    grid-column: 4 / span 8;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-md) var(--space-xl);
  }

  .caps__title {
    font-size: var(--fs-base);
    font-weight: var(--fw-black);
    line-height: var(--lh-tight);
  }

  .caps__summary {
    font-size: var(--fs-base);
    font-weight: var(--fw-light);
    line-height: var(--lh-tight);
  }

  .caps__quote {
    grid-column: 4 / span 8;
    font-size: var(--fs-lg);
    font-weight: var(--fw-light);
    line-height: var(--lh-tight);
  }

  /* 720-1024: la lista pasa a una columna con 16 px entre elementos, la cita
     baja a 20 px y el aire inferior a 40. */
  @media (max-width: 1023.98px) {
    .caps {
      padding-bottom: 40px;
    }

    .caps__list {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      gap: 16px;
    }

    .caps__quote {
      font-size: var(--fs-md);
    }
  }
</style>
