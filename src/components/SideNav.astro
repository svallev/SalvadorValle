---
import { nav } from '../data/site';
---

{/* El menú vive en el canal izquierdo y acompaña todo el recorrido.
    `aria-current` lo va marcando motion.js según la sección visible. */}
<nav class="sidenav" aria-label="Sections">
  <ul class="sidenav__list" role="list">
    {
      nav.map((item) => (
        <li>
          <a class="sidenav__link" href={item.href} data-nav-link>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .sidenav {
    position: fixed;
    top: 104px;
    /* Columna 1 de la rejilla: como la página ocupa todo el ancho, es
       exactamente el margen. */
    left: var(--grid-margin);
    width: 121px;
    z-index: 10;
  }

  .sidenav__list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Cada entrada ocupa 24 px (texto de 22) y hay 6 entre ellas: 30 px de paso,
     como en el componente «Menú item». */
  .sidenav__link {
    display: block;
    min-height: 24px;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
    color: var(--ink-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .sidenav__link:hover,
  .sidenav__link[aria-current='true'] {
    color: var(--accent);
  }

  /* Entre 720 y 1024 el menú sigue visible: el artboard «720-1024» lo mantiene
     en el margen izquierdo (16 px, que llega solo con --grid-margin). El
     contenido empieza en la columna 4, así que no se pisan. El texto baja a
     16 px; cada entrada conserva sus 24 px de alto. */
  @media (max-width: 1023.98px) {
    .sidenav__link {
      font-size: var(--fs-base);
    }
  }
  /* Móvil: el menú lateral desaparece; se abre desde la cabecera (MobileMenu). */
  @media (max-width: 719.98px) {
    .sidenav {
      display: none;
    }
  }
</style>
