---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { sections } from '../data/site';

const talks = (await getCollection('talks')).sort((a, b) => a.data.order - b.data.order);
const writings = (await getCollection('writings')).sort((a, b) => a.data.order - b.data.order);

const [featured, ...rest] = talks;
---

<section class="talks grid" id="talks">
  <h2 class="talks__label">{sections.talks.label}</h2>

  <div class="talks__block">
    <div class="talks__head">
      <h3 class="talks__sublabel">{sections.talks.talksLabel}</h3>
      <p class="talks__intro">{sections.talks.intro}</p>
    </div>

    {featured && <article class="talk talk--featured" data-reveal>
      <button
        class="talk__trigger"
        type="button"
        data-talk-open
        data-talk-id={featured.data.youtubeId}
        data-talk-title={featured.data.title}
        disabled={!featured.data.youtubeId}
      >
        <span class="talk__media talk__media--wide">
          {featured.data.thumbnail
            ? <Image src={featured.data.thumbnail} alt={featured.data.thumbnailAlt} format="webp" widths={[640, 1012, 1600]} sizes="71vw" loading="lazy" />
            : <span class="talk__placeholder" aria-hidden="true"></span>}
          {featured.data.youtubeId && (
            <span class="talk__play" aria-hidden="true">
              <svg viewBox="0 0 25 30" fill="currentColor"><path d="M0 0 25 15 0 30Z" /></svg>
            </span>
          )}
        </span>
        <span class="talk__title" lang={featured.data.lang}>{featured.data.title}</span>
      </button>
      <p class="talk__summary">{featured.body}</p>
    </article>}

    <div class="talks__row">
      {
        rest.map((talk) => (
          <article class="talk" data-reveal>
            <button
              class="talk__trigger"
              type="button"
              data-talk-open
              data-talk-id={talk.data.youtubeId}
              data-talk-title={talk.data.title}
              disabled={!talk.data.youtubeId}
            >
              <span class="talk__media">
                {talk.data.thumbnail
                  ? <Image src={talk.data.thumbnail} alt={talk.data.thumbnailAlt} format="webp" widths={[316, 632, 1012]} sizes="(max-width: 1023.98px) 71vw, 22vw" loading="lazy" />
                  : <span class="talk__placeholder" aria-hidden="true"></span>}
                {talk.data.youtubeId && (
                  <span class="talk__play" aria-hidden="true">
                    <svg viewBox="0 0 25 30" fill="currentColor"><path d="M0 0 25 15 0 30Z" /></svg>
                  </span>
                )}
              </span>
              <span class="talk__title" lang={talk.data.lang}>{talk.data.title}</span>
            </button>
            <p class="talk__summary">{talk.body}</p>
          </article>
        ))
      }
    </div>
  </div>

  <div class="talks__writings">
    <h3 class="talks__sublabel">{sections.talks.writingsLabel}</h3>

    <ul class="writings" role="list">
      {
        writings.map((writing) => {
          const Tag = writing.data.url ? 'a' : 'span';
          return (
            <li class="writings__item" data-reveal>
              <Tag
                class="writings__link"
                {...(writing.data.url
                  ? { href: writing.data.url, target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                <span class="writings__thumb" aria-hidden="true">
                  {writing.data.thumbnail && (
                    <Image src={writing.data.thumbnail} alt="" format="webp" widths={[80, 100]} sizes="80px" loading="lazy" />
                  )}
                </span>
                <span class="writings__title" lang={writing.data.lang}>{writing.data.title}</span>
                {/* Flecha decorativa del diseño. El aviso de que el enlace abre
                    fuera va en texto, que es lo que sí se anuncia. */}
                <span class="writings__arrow" aria-hidden="true">↗</span>
                {writing.data.url && <span class="visually-hidden">(opens in a new tab)</span>}
              </Tag>
            </li>
          );
        })
      }
    </ul>

    <p class="talks__quote">{sections.talks.quote}</p>
  </div>
</section>

<style>
  /* Talks & Posts: 120 px desde los clientes. */
  .talks {
    padding-block: 120px 0;
  }

  /* La fila del rótulo mide 32 px (la fija el propio texto, de alto fijo en
     el artboard) y el bloque de charlas empieza justo debajo. */
  .talks__label {
    grid-column: 3 / span 10;
    min-height: 32px;
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    /* En el artboard estos titulares van al 30 %: ordenan sin pesar. */
    opacity: 0.3;
  }

  /* 24 px de relleno arriba y 32 entre la cabecera y la lista de charlas.
     Abajo el frame pide 40, pero tiene alto fijo y el filete cae más abajo:
     entre 72 y 89 px según el artboard. Se redondea a 80. */
  .talks__block {
    grid-column: 4 / span 9;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: 24px 80px;
    border-bottom: 1px solid var(--rule);
  }

  /* Rótulo y entradilla van a 12 px, más juntos que el resto del bloque. */
  .talks__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Escritos: 24 px tras el filete y 32 entre rótulo, lista y cita. Los 16 de
     abajo son, otra vez, lo que sobra de un frame de alto fijo (13-28 px). */
  .talks__writings {
    grid-column: 4 / span 8;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    padding-block: 24px 16px;
  }

  .talks__sublabel {
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    color: var(--accent);
  }

  .talks__intro,
  .talks__quote {
    font-size: var(--fs-lg);
    font-weight: var(--fw-light);
    line-height: var(--lh-tight);
  }

  .talks__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  /* 10 px entre miniatura, título y descripción. */
  .talk {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .talk__trigger {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
  }

  /* Sin id de YouTube todavía no hay nada que abrir: la tarjeta se lee, pero
     no finge ser un botón que funciona. */
  .talk__trigger:disabled {
    cursor: default;
  }

  /* Contenedor de consulta: el icono de play mide siempre la misma fracción de
     la miniatura (en el diseño, 120 px sobre 1012 y 60 px sobre 510). */
  .talk__media {
    position: relative;
    display: block;
    container-type: inline-size;
    aspect-ratio: 316 / 160;
    overflow: hidden;
    border-radius: 8px;
    background: var(--placeholder);
  }

  .talk__media--wide {
    aspect-ratio: 1012 / 440;
  }

  .talk__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .talk__trigger:not(:disabled):hover .talk__media :global(img) {
    transform: scale(1.03);
  }

  .talk__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--placeholder);
  }

  /* Triángulo blanco al 80 % centrado sobre la miniatura, como en el artboard.
     Solo aparece cuando hay vídeo que abrir. */
  .talk__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--white);
    opacity: 0.8;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  /* 25 × 30 sobre 316 y 75 × 90 sobre 1012 en el artboard de 1440. */
  .talk__play svg {
    width: 7.9cqi;
    height: auto;
    aspect-ratio: 25 / 30;
  }

  .talk__media--wide .talk__play svg {
    width: 7.41cqi;
  }

  .talk__trigger:not(:disabled):hover .talk__play {
    opacity: 1;
  }

  .talk__title {
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
  }

  .talk__trigger:not(:disabled):hover .talk__title {
    color: var(--accent);
  }

  .talk__summary {
    font-size: var(--fs-base);
    font-weight: var(--fw-light);
    line-height: var(--lh-tight);
  }

  .writings {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Cada escrito es una fila de 104 px, filete incluido, no una lista corrida:
     en el artboard quedan 12 px de aire entre una y la siguiente. El filete es
     un trazo interior en Penpot, que no ocupa sitio: por eso sombra y no borde. */
  .writings__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 104px;
    padding-block: var(--space-xs) 16px;
    box-shadow: inset 0 -1px 0 var(--rule);
    font-size: var(--fs-xl);
    font-weight: var(--fw-light);
    line-height: var(--lh-tight);
    transition: color var(--duration-fast) var(--ease-out);
  }

  a.writings__link:hover {
    color: var(--accent);
  }

  /* Miniatura de 80 × 80 con radio 8. Sin imagen se queda el hueco gris, como
     en las charlas, para que el título empiece donde marca el diseño. */
  .writings__thumb {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    overflow: hidden;
    border-radius: 8px;
    background: var(--placeholder);
    box-shadow: 0 0 4px 0 #00000040;
  }

  .writings__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .writings__title {
    flex: 1;
  }

  .writings__arrow {
    flex-shrink: 0;
    transition: transform var(--duration-base) var(--ease-out);
  }

  a.writings__link:hover .writings__arrow {
    transform: translate(4px, -4px);
  }

  /* 720-1024 */
  @media (max-width: 1023.98px) {
    /* De los clientes a «Talks & Writing» quedan 40 px en lugar de 120. */
    .talks {
      padding-top: 40px;
    }

    .talks__intro {
      font-size: var(--fs-md);
    }

    /* Las tres charlas pequeñas se apilan a todo el ancho del bloque, con la
       misma proporción de miniatura que en escritorio. */
    .talks__row {
      grid-template-columns: 1fr;
    }

    .talks__writings {
      gap: var(--space-sm);
    }

    /* El título baja a 20 px pero la flecha conserva sus 32 px. */
    .writings__link {
      gap: 16px;
      font-size: var(--fs-md);
    }

    .writings__arrow {
      font-size: var(--fs-xl);
    }
  }
  /* Móvil: hueco de sección por arriba. Abajo los escritos no dejan relleno:
     el hueco hasta Background lo pone Background. */
  @media (max-width: 719.98px) {
    .talks {
      padding-top: var(--section-space);
    }

    .talks__label {
      min-height: 0;
      font-size: var(--fs-md);
    }

    .talks__block {
      padding-block: var(--space-md) var(--space-xl);
    }

    .talks__writings {
      padding-bottom: 0;
    }

    .talks__intro,
    .talks__quote {
      font-size: var(--fs-sm);
      line-height: 1.3;
    }

    /* Todas las charlas iguales, la destacada incluida: 16:9 y un play de
       28 px, que a este tamaño ya no necesita escalar con la miniatura. */
    .talk__media,
    .talk__media--wide {
      aspect-ratio: 16 / 9;
    }

    .talk__play svg,
    .talk__media--wide .talk__play svg {
      width: 28px;
    }

    .talk__title {
      line-height: 1.25;
    }

    .talk__summary {
      line-height: 1.35;
    }

    /* Escritos: filas de 72 px con miniatura de 56, título y flecha a 18/20. */
    .writings__link {
      gap: var(--space-sm);
      min-height: 72px;
      padding-block: var(--space-xs) var(--space-sm);
      font-size: var(--fs-sm);
      line-height: 1.25;
    }

    .writings__thumb {
      width: 56px;
      height: 56px;
    }

    .writings__arrow {
      font-size: var(--fs-md);
    }
  }
</style>
