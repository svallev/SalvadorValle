---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { sections } from '../data/site';
import collage from '../assets/work-collage.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section class="work grid" id="work">
  <h2 class="work__label">{sections.work.label}</h2>

  <ul class="work__list" role="list">
    {
      projects.map((project) => (
        <li class="work__item" data-reveal>
          <h3 class="work__title">{project.data.title}</h3>
          <p class="work__summary">{project.body}</p>
        </li>
      ))
    }
  </ul>

  <figure class="work__collage" data-parallax>
    <Image
      src={collage}
      alt="A collage of interfaces, products and design work by Salvador Valle"
      widths={[640, 960, 1128, 1600, 2000]}
      sizes="(max-width: 719.98px) 100vw, 80vw"
      loading="lazy"
    />
  </figure>
</section>

<style>
  /* Frame 16. Tres filas: rótulo, proyectos y collage. */
  .work {
    padding-block: 0;
  }

  /* La fila del rótulo mide 42 px aunque el texto ocupe 29: la fija un
     rectángulo invisible del artboard. */
  .work__label {
    grid-column: 3 / span 4;
    min-height: calc(42px * var(--k));
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
    /* En el artboard estos titulares van al 30 %: ordenan sin pesar. */
    opacity: 0.3;
  }

  .work__list {
    grid-column: 4 / span 8;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    /* 32 px a 1440 y 24 px a 1024: el artboard «Desktop hasta 1024» estrecha
       el hueco. Entre ambos anchos se interpola en línea recta. Por encima de
       1440 el canal crece con `--k`, como el resto de la rejilla. */
    gap: max(clamp(24px, calc(1.923vw + 4.31px), 32px), calc(32px * var(--k)));
    padding-top: calc(24px * var(--k));
  }

  /* A 1440 las cuatro filas miden lo mismo (la del proyecto más largo); a 1024
     cada fila mide lo que su contenido. */
  @media (min-width: 1440px) {
    .work__list {
      grid-auto-rows: 1fr;
    }
  }

  .work__title {
    font-size: var(--fs-base);
    font-weight: var(--fw-black);
    line-height: var(--lh-tight);
  }

  .work__summary {
    font-size: var(--fs-base);
    font-weight: var(--fw-light);
    line-height: var(--lh-tight);
  }

  /* 80 px arriba y abajo: el de abajo es la separación con «What I actually
     run», que ya no lleva margen propio. */
  .work__collage {
    grid-column: 3 / span 10;
    margin: 0;
    padding-block: calc(80px * var(--k));
  }

  .work__collage :global(img) {
    width: 100%;
    height: auto;
  }

  /* 720-1024: los proyectos se apilan en una columna con 24 px entre ellos, y
     el collage se queda con 40 px de aire arriba y abajo. */
  @media (max-width: 1023.98px) {
    .work__list {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .work__collage {
      padding-block: 40px;
    }
  }
  /* Móvil: rótulo a 20 px sin la fila fija de 42, textos algo más abiertos y
     32 px de aire alrededor del collage, que llega a los bordes de la página
     anulando el margen de la rejilla. */
  @media (max-width: 719.98px) {
    .work__label {
      min-height: 0;
      font-size: var(--fs-md);
    }

    .work__list {
      padding-top: var(--space-md);
    }

    .work__title {
      line-height: 1.25;
    }

    .work__summary {
      line-height: 1.35;
    }

    .work__collage {
      margin-inline: calc(-1 * var(--grid-margin));
      padding-block: var(--space-lg);
    }
  }

  /* Pantallas grandes: cada columna del resumen crece hasta unos 90
     caracteres por línea sin el tope. Se acota como el resto de párrafos
     largos del sitio (hero, background). */
  @media (min-width: 1920px) {
    .work__summary {
      max-width: 62ch;
    }
  }
</style>
