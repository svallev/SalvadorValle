---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { sections } from '../data/site';
import collage from '../assets/work-collage.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section class="work grid" id="work">
  <h2 class="work__label">{sections.work.label}</h2>

  <ul class="work__list" role="list">
    {
      projects.map((project) => (
        <li class="work__item" data-reveal>
          <h3 class="work__title">{project.data.title}</h3>
          <p class="work__summary">{project.body}</p>
        </li>
      ))
    }
  </ul>

  <figure class="work__collage" data-parallax>
    <Image
      src={collage}
      alt="A collage of interfaces, products and design work by Salvador Valle"
      widths={[640, 960, 1128, 1600]}
      sizes="(max-width: 1100px) 92vw, 1128px"
      loading="lazy"
    />
  </figure>
</section>

<style>
  .work {
    padding-block: 0;
  }

  .work__label {
    grid-column: 3 / span 4;
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    line-height: var(--lh-tight);
  /* En el artboard estos titulares van al 30 %: ordenan sin pesar. */
    opacity: 0.3;
  }

  .work__list {
    grid-column: 4 / span 8;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    /* Filas de altura uniforme, como la rejilla del artboard: con filas
       automáticas los huecos bailan según lo largo que sea cada texto. */
    grid-auto-rows: minmax(132px, auto);
    padding-block: var(--space-md) var(--space-xl);
  }

  .work__title {
    font-size: var(--fs-base);
    font-weight: var(--fw-black);
    line-height: var(--lh-tight);
  }

  .work__summary {
    font-size: var(--fs-base);
    font-weight: var(--fw-light);
    line-height: var(--lh-tight);
  }

  .work__collage {
    grid-column: 3 / span 10;
    margin: 0;
    padding-top: 80px;
  }

  .work__collage :global(img) {
    width: 100%;
    height: auto;
  }
</style>
