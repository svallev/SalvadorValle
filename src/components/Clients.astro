---
import { getCollection } from 'astro:content';
import { sections } from '../data/site';

// `getCollection` devuelve las entradas ordenadas por id, es decir alfabéticamente.
// El artboard tiene su propio orden, así que se recupera con `order`.
const clients = (await getCollection('clients')).sort((a, b) => a.data.order - b.data.order);
---

<section class="clients grid">
  <h2 class="clients__label">{sections.clients.label}</h2>

  <ul class="clients__list" role="list">
    {clients.map((client) => <li class="clients__chip" data-reveal>{client.data.name}</li>)}
  </ul>
</section>

<style>
  /* Frame 20: sin relleno propio; el aire de arriba lo pone Capabilities. */
  .clients {
    padding-block: 0;
  }

  .clients__label {
    grid-column: 4 / -1;
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    color: var(--accent);
    line-height: var(--lh-tight);
  }

  .clients__list {
    grid-column: 4 / span 8;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
  }

  /* Píldora de 28 px (radio 100 en el artboard) con el filete por dentro. */
  .clients__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    padding-inline: var(--space-sm);
    border: 1px solid var(--rule-strong);
    border-radius: 100px;
    font-size: var(--fs-base);
    font-weight: var(--fw-light);
    line-height: var(--lh-tight);
    white-space: nowrap;
  }

  /* 720-1024: la píldora se ajusta al texto, 20 px de alto y 8 px a los lados. */
  @media (max-width: 1023.98px) {
    .clients__chip {
      height: 20px;
      padding-inline: var(--space-xs);
    }
  }
</style>
