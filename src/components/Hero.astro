---
import { hero } from '../data/site';
---

<section class="hero grid" id="hi">
  <div class="hero__content">
    <h1 class="hero__headline" data-hero-headline>
      {
        hero.headline.map((part) => (
          <span
            class:list={['hero__part', { 'hero__part--accent': part.accent }]}
            style={`font-weight:${part.weight}`}
          >
            {part.text}
          </span>
        ))
      }
    </h1>

    <div class="hero__body">
      <p class="hero__intro">
        {hero.intro.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
      </p>
      <p class="hero__claim">{hero.claim}</p>
    </div>
  </div>
</section>

<style>
  /* Frame 8: el bloque arranca pegado a la cabecera y deja 120 px debajo. */
  .hero {
    padding-block: 0 120px;
  }

  .hero__content {
    grid-column: 4 / -1;
  }

  /* 16 px entre titular, entradilla y claim: fuera de la escala de espaciado,
     pero es lo que marcan los tres artboards. */
  .hero__headline {
    font-family: var(--font-display);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    color: var(--ink-pure);
    /* El titular se parte en tramos; sin esto heredaría el peso del body. */
    font-weight: var(--fw-regular);
    margin-bottom: 16px;
  }

  .hero__part--accent {
    color: var(--accent);
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero__intro {
    font-size: var(--fs-md);
    font-weight: var(--fw-regular);
    line-height: var(--lh-body);
    max-width: 62ch;
  }

  .hero__claim {
    font-family: var(--font-display);
    font-size: var(--fs-display-sm);
    font-weight: var(--fw-regular);
    line-height: var(--lh-tight);
  }

  /* 720-1024: el bloque se queda en 8 columnas (deja libre la última), el
     aire inferior baja de 120 a 80 y el claim de 48 a 36. El titular mantiene
     sus 104 px y pasa a dos líneas. */
  @media (max-width: 1023.98px) {
    .hero {
      padding-block: 0 80px;
    }

    .hero__content {
      grid-column: 4 / span 8;
    }

    .hero__claim {
      font-size: 36px;
    }
  }
</style>
