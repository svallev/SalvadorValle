---
import { hero } from '../data/site';
---

<section class="hero grid" id="hi">
  <div class="hero__content">
    <h1 class="hero__headline" data-hero-headline>
      {
        hero.headline.map((part) => (
          <span class:list={['hero__part', { 'hero__part--accent': part.accent }]}>
            {part.text}
          </span>
        ))
      }
    </h1>

    <div class="hero__body">
      <p class="hero__intro">
        <span class="hero__greeting">{hero.greeting}</span>{' '}
        {hero.intro.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
      </p>
      <p class="hero__claim">{hero.claim}</p>
    </div>

    <ul class="hero__stats" role="list">
      {
        hero.stats.map((stat) => (
          <li class="hero__stat">
            <p class="hero__stat-value">
              {stat.prefix}
              <span data-count={stat.value} data-decimals={stat.decimals}>
                {stat.value.toFixed(stat.decimals)}
              </span>
              <span class="hero__stat-unit">{stat.unit}</span>
            </p>
            <p class="hero__stat-label">{stat.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Frame 8: el bloque arranca pegado a la cabecera y deja 120 px debajo. */
  .hero {
    padding-block: 0 calc(120px * var(--k));
  }

  .hero__content {
    grid-column: 4 / -1;
  }

  /* 16 px entre titular, entradilla y claim: fuera de la escala de espaciado,
     pero es lo que marcan los tres artboards. */
  .hero__headline {
    font-family: var(--font-headline);
    font-size: calc(104px * var(--k));
    line-height: var(--lh-display);
    letter-spacing: calc(-5px * var(--k));
    color: var(--ink);
    /* Prata solo existe en 400; sin esto heredaría el peso del body y el
       navegador sintetizaría uno. */
    font-weight: var(--fw-regular);
    margin-bottom: calc(16px * var(--k));
  }

  .hero__part--accent {
    color: var(--accent);
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    gap: calc(16px * var(--k));
  }

  .hero__intro {
    font-size: var(--fs-md);
    font-weight: var(--fw-regular);
    line-height: var(--lh-body);
    max-width: 62ch;
  }

  .hero__greeting {
    font-weight: var(--fw-black);
    color: var(--accent);
  }

  .hero__claim {
    font-family: var(--font-display);
    font-size: var(--fs-display-sm);
    font-weight: var(--fw-regular);
    line-height: var(--lh-tight);
  }

  /* Cifras clave: cuatro columnas iguales bajo el claim. El tamaño de la cifra
     baja con el ancho (5vw) para que «€3.5M» quepa en su columna entre 1024 y
     1440; a partir de 1440 manda el 72 px de diseño. */
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: calc(12px * var(--k));
    border-top: 1px solid var(--rule);
    padding-top: calc(16px * var(--k));
  }

  .hero__stat-value {
    font-family: var(--font-headline);
    font-size: min(calc(72px * var(--k)), 5vw);
    font-weight: var(--fw-regular);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: calc(-3px * var(--k));
    color: var(--ink);
  }

  .hero__stat-unit {
    color: var(--accent);
  }

  .hero__stat-label {
    font-size: var(--fs-base);
    font-weight: var(--fw-light);
    line-height: 1.35;
  }

  /* 720-1024: el bloque se queda en 8 columnas (deja libre la última), el
     aire inferior baja de 120 a 80 y el claim de 48 a 36. El titular mantiene
     sus 104 px y pasa a dos líneas. */
  @media (max-width: 1023.98px) {
    .hero {
      padding-block: 0 80px;
    }

    .hero__content {
      grid-column: 4 / span 8;
    }

    .hero__claim {
      font-size: 36px;
    }

    /* Cuatro columnas de ~90 px no dan para una cifra: pasan a dos por fila. */
    .hero__stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero__stat-value {
      font-size: 56px;
    }
  }
  /* Móvil: titular a 52 px en dos líneas equilibradas, entradilla a 16 y claim
     a 28. El hueco hasta los proyectos es el de sección (tokens.css). */
  @media (max-width: 719.98px) {
    .hero {
      padding-block: 0 var(--section-space);
    }

    .hero__headline {
      font-size: 52px;
      line-height: 1;
      text-wrap: balance;
    }

    .hero__intro {
      font-size: var(--fs-base);
    }

    .hero__claim {
      font-size: 28px;
      line-height: 1.15;
    }

    /* Una columna; la cifra se encoge con el ancho hasta los 56 px. */
    .hero__stats {
      grid-template-columns: 1fr;
    }

    .hero__stat-value {
      font-size: clamp(40px, 15vw, 56px);
    }
  }
</style>
