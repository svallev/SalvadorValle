---
// Un único <dialog> para toda la página. El <iframe> NO está aquí: lo crea el
// script al abrir y lo destruye al cerrar. Así no se cargan cuatro reproductores
// de YouTube en cada visita, y el vídeo se para solo al cerrar en vez de seguir
// sonando de fondo.
---

<dialog class="modal" id="video-modal" aria-labelledby="video-modal-title">
  <div class="modal__head">
    <h2 class="modal__title" id="video-modal-title"></h2>
    <button class="modal__close" type="button" data-modal-close>
      <span class="visually-hidden">Close video</span>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path
          d="M5 5l14 14M19 5L5 19"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div class="modal__player" data-modal-player></div>
</dialog>

<style>
  .modal {
    width: min(1100px, 92vw);
    padding: var(--space-md);
    border: none;
    background: var(--ink);
    color: var(--white);
  }

  .modal::backdrop {
    background: rgb(17 17 17 / 0.88);
  }

  .modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .modal__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
  }

  .modal__close {
    display: grid;
    place-items: center;
    padding: var(--space-2xs);
    background: none;
    border: none;
    color: currentColor;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .modal__close:hover {
    color: var(--accent);
  }

  .modal__player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--ink-pure);
  }

  .modal__player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
