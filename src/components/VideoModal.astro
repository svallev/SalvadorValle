---
// Un único <dialog> para toda la página. El <iframe> NO está aquí: lo crea el
// script al abrir y lo destruye al cerrar. Así no se cargan cuatro reproductores
// de YouTube en cada visita, y el vídeo se para solo al cerrar en vez de seguir
// sonando de fondo.
---

<dialog class="modal" id="video-modal" aria-labelledby="video-modal-title">
  <div class="modal__head">
    <h2 class="modal__title" id="video-modal-title"></h2>
    <button class="modal__close" type="button" data-modal-close>
      <span class="visually-hidden">Close video</span>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path
          d="M5 5l14 14M19 5L5 19"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div class="modal__player" data-modal-player></div>
</dialog>

<style>
  /* Sin caja propia: el <dialog> es transparente y el vídeo flota sobre la
     página, que se sigue viendo detrás a través del fondo translúcido.
     El ancho se limita también por el alto de la ventana para que el
     reproductor 16:9 y la cabecera quepan siempre sin scroll. */
  .modal {
    width: min(calc(1100px * var(--k)), 92vw, calc((100dvh - 160px) * 16 / 9));
    max-width: none;
    max-height: none;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--white);
    overflow: visible;
  }

  .modal::backdrop {
    background: rgb(17 17 17 / 0.6);
    backdrop-filter: blur(4px);
  }

  .modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .modal__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-tight);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
  }

  /* 40 × 40 de zona de clic, más fácil de acertar que el propio aspa. */
  .modal__close {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: calc(40px * var(--k));
    height: calc(40px * var(--k));
    padding: 0;
    background: rgb(17 17 17 / 0.5);
    border: none;
    border-radius: 100px;
    color: var(--white);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .modal__close:hover {
    background: var(--white);
    color: var(--accent);
  }

  .modal__player {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px;
    background: var(--ink-pure);
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.45);
  }

  .modal__player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
