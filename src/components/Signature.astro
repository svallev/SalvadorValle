---
import { site } from '../data/site';
import SignatureMark from '../assets/signature.svg';
---

{/* El nombre como logotipo, a sangre de margen a margen tal y como cierra el
    artboard. Es decorativo: el nombre real ya está en la cabecera y en el pie,
    así que aquí sobra repetirlo para un lector de pantalla. */}
<div class="signature" role="img" aria-label={site.name} data-reveal>
  <SignatureMark class="signature__mark" />
</div>

<style>
  .signature {
    /* Franja de al menos 358 px con el nombre centrado en vertical: a 1440 son
       80 + 196 + 80, y a 1024 el artboard mantiene esa altura aunque el
       logotipo mida menos. Los filetes de arriba y abajo van a sangre: son los
       únicos negros opacos del artboard, todos los demás van al 30 %. */
    display: grid;
    align-content: center;
    min-height: calc(358px * var(--k));
    padding-block: calc(80px * var(--k));
    /* Trazo interior, como en Penpot: no suma altura. El de arriba lo lleva
       ahora `main` (ver index.astro): así viaja con el contenido que sube y
       marca mejor el borde que descubre el pie al llegar al final. */
    box-shadow: inset 0 -1px 0 var(--ink-pure);
      opacity: 0.8;
      background-image: radial-gradient(circle, #DFDFDF 1.2px, transparent 1.2px);
      background-size: 15px 15px;
  }

  .signature :global(.signature__mark) {
    display: block;
    width: 100%;
    height: auto;
    color: var(--ink);
  }

  /* 720-1024: el aire se reduce a la mitad, 40 px arriba y abajo. */
  @media (max-width: 1023.98px) {
    .signature {
      min-height: 0;
      padding-block: 40px;
    }
  }
  /* Móvil: 32 px arriba y abajo. Sin relleno lateral: la firma llega a los
     bordes de la pantalla, como en el resto de anchos. */
  @media (max-width: 719.98px) {
    .signature {
      padding-block: var(--space-lg);
    }
  }
</style>
