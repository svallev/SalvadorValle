---
import { site, footer } from '../data/site';
---

<footer class="footer">
  <p class="footer__copy">{footer.copyright}</p>

  <ul class="footer__links" role="list">
    {
      footer.links.map((link) => (
        <li>
          <a class="footer__link" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      ))
    }
    <li>
      <a class="footer__link" href={`mailto:${site.email}`}>{site.email}</a>
    </li>
  </ul>
</footer>

<style>
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-md) var(--grid-margin);
    color: var(--ink-pure);
  }

  .footer__copy,
  .footer__link {
    font-size: var(--fs-md);
    font-weight: var(--fw-light);
    line-height: var(--lh-body);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
  }

  .footer__link {
    text-decoration: underline;
  }

  /* 720-1024: texto a 16 px con interlineado 2 (la fila sigue midiendo 32 px)
     y 16 px entre enlaces para que todo quepa en una línea. */
  @media (max-width: 1023.98px) {
    .footer__copy,
    .footer__link {
      font-size: var(--fs-base);
      line-height: 2;
    }

    .footer__links {
      gap: 16px;
    }
  }
</style>
