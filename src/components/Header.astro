---
import { site } from '../data/site';
import ThemeMenu from './ThemeMenu.astro';

interface Props {
  /* Tema marcado en el menú al construir (ver ThemeMenu). */
  theme?: string;
  /* Sin menú de secciones: /agents/ no tiene MobileMenu que abrir. */
  sections?: boolean;
}

const { theme, sections = true } = Astro.props;
---

<header class="header">
  <a class="header__name" href="#hi">
    {/* Libre Barcode 128 Text dibuja el texto como código de barras con la
        versión legible debajo. En escritorio va el nombre; por debajo de 1024,
        solo las iniciales. Las dos versiones visibles se ocultan al lector de
        pantalla, que recibe siempre el nombre completo. */}
    <span class="header__full" aria-hidden="true">{site.name}</span>
    <span class="header__initials" aria-hidden="true">SV</span>
    <span class="visually-hidden">{site.name}</span>
  </a>

  {/* El botón de tema ocupa el sitio que tenía LinkedIn, que sigue en el pie
      y en el menú móvil. En móvil comparte la esquina con la hamburguesa. */}
  <div class="header__actions">
    <ThemeMenu current={theme} />
    {/* Móvil: menú de secciones. El <dialog> está en MobileMenu.astro. */}
    {sections && <button
      class="header__menu"
      type="button"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-open
    >
      <span class="visually-hidden">Open menu</span>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.5" fill="none"></path>
      </svg>
    </button>}
  </div>
</header>

<style>
  /* Acompaña todo el recorrido. Fondo transparente a propósito: el contenido
     pasa por debajo al bajar y se ve a través, como pide el diseño. En móvil
     sí lleva fondo (ver el bloque de 720). */
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(104px * var(--k));
    padding-inline: var(--grid-margin);
    background: transparent;
  }

  .header__name {
    font-family: var(--font-barcode);
    font-size: var(--fs-barcode);
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-barcode);
    line-height: var(--lh-tight);
    color: var(--ink-pure);
  }

  .header__initials {
    display: none;
  }

  @media (max-width: 1023.98px) {
    .header__full {
      display: none;
    }

    .header__initials {
      display: inline;
    }
  }

  .header__actions {
    display: flex;
    align-items: center;
  }

  .header__menu {
    display: none;
  }

  /* Móvil: cabecera de 64 px, iniciales a 32, y el botón de tema seguido del
     de menú. 44 × 44 de zona táctil; el margen negativo alinea el icono con
     el borde de la rejilla. */
  @media (max-width: 719.98px) {
    /* En móvil el contenido pasa pegado al nombre y se pisaba con él: fondo
       del color de la página y, debajo, un degradado a transparente para que
       el contenido se funda al entrar en vez de cortarse en seco. */
    .header {
      height: 64px;
      background: var(--paper);
    }

    .header::after {
      content: '';
      position: absolute;
      inset: 100% 0 auto;
      height: 24px;
      background: linear-gradient(var(--paper), transparent);
      pointer-events: none;
    }

    /* Arriba del todo el titular empieza pegado a la cabecera y el degradado
       lo velaría: aparece con los primeros 24 px de desplazamiento. Donde no
       hay animaciones ligadas al scroll, el degradado simplemente no está. */
    @supports (animation-timeline: scroll()) {
      .header::after {
        opacity: 0;
        animation: header-fade linear both;
        animation-timeline: scroll();
        animation-range: 0 24px;
      }
    }

    @keyframes header-fade {
      to {
        opacity: 1;
      }
    }

    .header__name {
      font-size: 32px;
    }

    .header__menu {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      background: none;
      border: 0;
      color: var(--ink);
      cursor: pointer;
    }
  }
</style>
