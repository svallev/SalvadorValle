---
import { site } from '../data/site';
import { footer } from '../data/site';

const linkedin = footer.links.find((l) => l.label === 'LinkedIn')!;
---

<header class="header">
  <a class="header__name" href="#hi">
    {/* Libre Barcode 128 Text dibuja el texto como código de barras con la
        versión legible debajo. En escritorio va el nombre; por debajo de 1024,
        solo las iniciales. Las dos versiones visibles se ocultan al lector de
        pantalla, que recibe siempre el nombre completo. */}
    <span class="header__full" aria-hidden="true">{site.name}</span>
    <span class="header__initials" aria-hidden="true">SV</span>
    <span class="visually-hidden">{site.name}</span>
  </a>

  <a class="header__social" href={linkedin.href} target="_blank" rel="noopener noreferrer">
    <span class="visually-hidden">{site.name} on LinkedIn (opens in a new tab)</span>
    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
      <path
        d="M17 2C18.3261 2 19.5979 2.52678 20.5355 3.46447C21.4732 4.40215 22 5.67392 22 7V17C22 18.3261 21.4732 19.5979 20.5355 20.5355C19.5979 21.4732 18.3261 22 17 22H7C5.67392 22 4.40215 21.4732 3.46447 20.5355C2.52678 19.5979 2 18.3261 2 17V7C2 5.67392 2.52678 4.40215 3.46447 3.46447C4.40215 2.52678 5.67392 2 7 2H17ZM8 10C7.73478 10 7.48043 10.1054 7.29289 10.2929C7.10536 10.4804 7 10.7348 7 11V16C7 16.2652 7.10536 16.5196 7.29289 16.7071C7.48043 16.8946 7.73478 17 8 17C8.26522 17 8.51957 16.8946 8.70711 16.7071C8.89464 16.5196 9 16.2652 9 16V11C9 10.7348 8.89464 10.4804 8.70711 10.2929C8.51957 10.1054 8.26522 10 8 10ZM14 10C13.5988 9.99978 13.2016 10.08 12.832 10.236L12.707 10.293C12.5671 10.1532 12.389 10.058 12.195 10.0194C12.0011 9.98085 11.8 10.0007 11.6173 10.0763C11.4346 10.152 11.2785 10.2801 11.1686 10.4445C11.0587 10.609 11 10.8022 11 11V16C11 16.2652 11.1054 16.5196 11.2929 16.7071C11.4804 16.8946 11.7348 17 12 17C12.2652 17 12.5196 16.8946 12.7071 16.7071C12.8946 16.5196 13 16.2652 13 16V13C13 12.7348 13.1054 12.4804 13.2929 12.2929C13.4804 12.1054 13.7348 12 14 12C14.2652 12 14.5196 12.1054 14.7071 12.2929C14.8946 12.4804 15 12.7348 15 13V16C15 16.2652 15.1054 16.5196 15.2929 16.7071C15.4804 16.8946 15.7348 17 16 17C16.2652 17 16.5196 16.8946 16.7071 16.7071C16.8946 16.5196 17 16.2652 17 16V13C17 12.2044 16.6839 11.4413 16.1213 10.8787C15.5587 10.3161 14.7956 10 14 10ZM8 7C7.75507 7.00003 7.51866 7.08996 7.33563 7.25272C7.15259 7.41547 7.03566 7.63975 7.007 7.883L7 8.01C7.00028 8.26488 7.09788 8.51003 7.27285 8.69537C7.44782 8.8807 7.68695 8.99223 7.94139 9.00717C8.19584 9.02211 8.44638 8.93933 8.64183 8.77573C8.83729 8.61214 8.9629 8.3801 8.993 8.127L9 8C9 7.73478 8.89464 7.48043 8.70711 7.29289C8.51957 7.10536 8.26522 7 8 7Z"
      ></path>
    </svg>
  </a>

  {/* Móvil: el icono de LinkedIn deja su sitio al menú, y LinkedIn pasa al
      propio menú y al pie. El <dialog> está en MobileMenu.astro. */}
  <button
    class="header__menu"
    type="button"
    aria-controls="mobile-menu"
    aria-expanded="false"
    data-menu-open
  >
    <span class="visually-hidden">Open menu</span>
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.5" fill="none"></path>
    </svg>
  </button>
</header>

<style>
  /* Acompaña todo el recorrido. Fondo transparente a propósito: el contenido
     pasa por debajo al bajar y se ve a través, como pide el diseño. En móvil
     sí lleva fondo (ver el bloque de 720). */
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 104px;
    padding-inline: var(--grid-margin);
    background: transparent;
  }

  .header__name {
    font-family: var(--font-barcode);
    font-size: var(--fs-barcode);
    font-weight: var(--fw-regular);
    letter-spacing: var(--ls-barcode);
    line-height: var(--lh-tight);
    color: var(--ink-pure);
  }

  .header__initials {
    display: none;
  }

  @media (max-width: 1023.98px) {
    .header__full {
      display: none;
    }

    .header__initials {
      display: inline;
    }
  }

  .header__social {
    color: var(--ink-faint);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .header__social:hover {
    color: var(--ink);
  }

  .header__menu {
    display: none;
  }

  /* Móvil: cabecera de 64 px, iniciales a 32 y el botón de menú en lugar de
     LinkedIn. 44 × 44 de zona táctil; el margen negativo alinea el icono con
     el borde de la rejilla. */
  @media (max-width: 719.98px) {
    /* En móvil el contenido pasa pegado al nombre y se pisaba con él: fondo
       del color de la página y, debajo, un degradado a transparente para que
       el contenido se funda al entrar en vez de cortarse en seco. */
    .header {
      height: 64px;
      background: var(--paper);
    }

    .header::after {
      content: '';
      position: absolute;
      inset: 100% 0 auto;
      height: 24px;
      background: linear-gradient(var(--paper), transparent);
      pointer-events: none;
    }

    /* Arriba del todo el titular empieza pegado a la cabecera y el degradado
       lo velaría: aparece con los primeros 24 px de desplazamiento. Donde no
       hay animaciones ligadas al scroll, el degradado simplemente no está. */
    @supports (animation-timeline: scroll()) {
      .header::after {
        opacity: 0;
        animation: header-fade linear both;
        animation-timeline: scroll();
        animation-range: 0 24px;
      }
    }

    @keyframes header-fade {
      to {
        opacity: 1;
      }
    }

    .header__name {
      font-size: 32px;
    }

    .header__social {
      display: none;
    }

    .header__menu {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      background: none;
      border: 0;
      color: var(--ink);
      cursor: pointer;
    }
  }
</style>
