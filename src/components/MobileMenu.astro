---
import { site, nav, footer } from '../data/site';
---

{/* Menú a pantalla completa del móvil. Un <dialog> nativo, como el del vídeo:
    atrapa el foco, cierra con Esc y devuelve el foco al botón que lo abrió.
    Los enlaces llevan `data-nav-link`, así que motion.js les marca la sección
    activa igual que al menú lateral. La lógica está en scripts/mobile-menu.js. */}
<dialog class="menu" id="mobile-menu" aria-label="Menu">
  <div class="menu__bar">
    <span class="menu__initials" aria-hidden="true">SV</span>
    <button class="menu__close" type="button" data-menu-close>
      <span class="visually-hidden">Close menu</span>
      {/* Las mismas tres líneas que la hamburguesa de la cabecera: al abrir se
          cruzan en aspa, y al cerrar vuelven. */}
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path class="menu__line menu__line--top" d="M3 7h18"></path>
        <path class="menu__line menu__line--mid" d="M3 12h18"></path>
        <path class="menu__line menu__line--bottom" d="M3 17h18"></path>
      </svg>
    </button>
  </div>

  <nav aria-label="Sections">
    <ul class="menu__list" role="list">
      {
        nav.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a class="menu__link" href={item.href} data-nav-link>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="menu__contact" style={`--i: ${nav.length}`}>
    <a class="menu__email" href={`mailto:${site.email}`}>{site.email}</a>
    <ul class="menu__social" role="list">
      {
        footer.links.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</dialog>

<style>
  /* Ocupa toda la pantalla y tapa la página: no hay backdrop que se vea.

     Entra y sale con un fundido corto. `allow-discrete` mantiene el <dialog>
     en pantalla mientras se desvanece al cerrar (sin él, desaparecería de
     golpe), y @starting-style da el estado de partida al abrir. */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0 var(--grid-margin) 24px;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    opacity: 0;
    transition:
      opacity var(--menu-fade) var(--ease-out),
      display var(--menu-fade) allow-discrete,
      overlay var(--menu-fade) allow-discrete;
    --menu-fade: 160ms;
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;
  }

  @starting-style {
    .menu[open] {
      opacity: 0;
    }
  }

  /* Enlaces y contacto suben 12 px escalonados, 25 ms uno detrás de otro. Solo
     al abrir: al cerrar se van con el fundido del menú, sin moverse. */
  .menu__list li,
  .menu__contact {
    transition:
      opacity 220ms var(--ease-out),
      translate 220ms var(--ease-out);
    transition-delay: calc(var(--i) * 25ms);
  }

  @starting-style {
    .menu[open] .menu__list li,
    .menu[open] .menu__contact {
      opacity: 0;
      translate: 0 12px;
    }
  }

  /* La barra repite la cabecera al píxel para que abrir el menú no mueva nada:
     las iniciales y el aspa quedan donde estaban las iniciales y la hamburguesa. */
  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    height: 64px;
  }

  .menu__initials {
    font-family: var(--font-barcode);
    font-size: 32px;
    letter-spacing: var(--ls-barcode);
    line-height: var(--lh-tight);
    color: var(--ink-pure);
  }

  .menu__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
  }

  /* Hamburguesa → aspa. Las líneas exteriores bajan o suben al centro y giran
     45°; se alargan un 26 % para que el aspa mida 16 px, como la de antes. La
     central se encoge hasta desaparecer. */
  .menu__line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      translate 220ms var(--ease-out),
      rotate 220ms var(--ease-out),
      scale 220ms var(--ease-out),
      opacity 220ms var(--ease-out);
  }

  .menu[open] .menu__line--top {
    translate: 0 5px;
    rotate: 45deg;
    scale: 1.26 1;
  }

  .menu[open] .menu__line--mid {
    scale: 0 1;
    opacity: 0;
  }

  .menu[open] .menu__line--bottom {
    translate: 0 -5px;
    rotate: -45deg;
    scale: 1.26 1;
  }

  @starting-style {
    .menu[open] .menu__line {
      translate: 0 0;
      rotate: 0deg;
      scale: 1;
      opacity: 1;
    }
  }

  .menu__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding-top: 24px;
  }

  .menu__link {
    display: block;
    padding-block: 10px;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: var(--fw-regular);
    line-height: 1.1;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .menu__link:hover,
  .menu__link[aria-current='true'] {
    color: var(--accent);
  }

  /* Contacto al fondo de la pantalla, separado por un filete. */
  .menu__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--rule);
  }

  .menu__email {
    font-weight: var(--fw-medium);
    font-style: italic;
    text-decoration: underline;
  }

  .menu__social {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .menu__social a {
    text-decoration: underline;
  }

  .menu__email:hover,
  .menu__social a:hover {
    color: var(--accent);
  }
</style>
